{
  "name": "battery-hub",
  "version": "2.0.2",
  "description": "Live battery monitor for all your HID devices",
  "author": "doron",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-batteries.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "predist": "node scripts/build-batteries.js",
    "dist": "electron-builder",
    "installer": "node scripts/build-installer.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "node-hid": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.doron.batteryhub",
    "productName": "Battery Hub",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/write-manifest.js",
    "publish": [
      {
        "provider": "github",
        "owner": "DORON177",
        "repo": "battery-hub"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/node_modules/node-hid/hidapi/**",
      "!**/node_modules/node-hid/src/**",
      "!**/node_modules/node-hid/prebuilds/!(HID-win32-x64)/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "electronLanguages": [
      "en-US",
      "es",
      "es-419",
      "zh-CN",
      "zh-TW",
      "he"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Battery-Hub-Update-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Battery Hub"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "node-hid@3.3.0": true
  }
}
